{
  "experiment": "custom-unsupervised",
  "cells": [
    {"dataset": "fodors_zagats", "side": "right", "k": 1}
  ],
  "panels": ["single:minilm6"],
  "split": {"n_splits": 3, "seed": 0},
  "fit": {
    "init_threshold": 0.5,
    "missing": "ignore",
    "hard": false,
    "transitivity": false,
    "pi_M": null,
    "tol": 0.00001,
    "max_iter": 200
  },
  "search": {
    "c_bay": [0.001, 0.01, 0.1],
    "init_statistic": ["sum", "present_mean"]
  },
  "refinement": {
    "c_bay": [0.0, 0.0001],
    "init_statistic": ["sum", "present_mean"]
  },
  "thresholds": {
    "llr": [-5, -2, -1, 0, 1, 2, 5],
    "posterior": [0.1, 0.25, 0.5, 0.75, 0.9],
    "cosine": [0.3, 0.5, 0.7, 0.8, 0.9]
  },
  "ablations": {
    "zero_fill": {"missing": "zero"},
    "hard_em": {"hard": true}
  }
}
